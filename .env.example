# These accounts are technical local-only PostgreSQL logins for Docker development.
# Production credentials must not be committed.
# Application clients, providers, and admins never receive either connection string.
NODE_ENV=development
DATABASE_URL=postgresql://tender_local:tender_local_only@localhost:5432/tender_dev
DATABASE_URL_TEST=postgresql://tender_test:tender_test_local_only@localhost:5433/tender_test
AUTH_SECRET=01234567890123456789012345678901
APP_URL=http://localhost:3000
STORAGE_ENDPOINT=http://localhost:9000
STORAGE_REGION=us-east-1
STORAGE_BUCKET=tender-dev
STORAGE_BUCKET_TEST=tender-test
STORAGE_ACCESS_KEY_ID=tender_local
STORAGE_SECRET_ACCESS_KEY=tender_local_only
STORAGE_FORCE_PATH_STYLE=true
SELECTION_WORKER_SECRET=0123456789012345678901234567890123
