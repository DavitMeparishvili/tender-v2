# Add the runtime values to Vercel's Production environment. Mark passwords,
# access keys, and worker/auth secrets as Sensitive. Never commit populated
# values. DIRECT_DATABASE_URL is operator-only and is not needed in Vercel.
NODE_ENV=production

# PostgreSQL on the DigitalOcean Droplet. DIRECT_DATABASE_URL is used only by
# Prisma CLI migrations; for this small demo both URLs can point to the same
# endpoint. Percent-encode special characters in USER and PASSWORD.
DATABASE_URL=postgresql://tender_app:PASSWORD@db.example.com:5432/tender_demo?sslmode=require
DIRECT_DATABASE_URL=postgresql://tender_app:PASSWORD@db.example.com:5432/tender_demo?sslmode=require

# Exactly the public Vercel/custom-domain origin; no trailing slash.
APP_URL=https://app.example.com
# Required for account activation and password recovery email delivery.
RESEND_API_KEY=re_replace-with-a-sending-api-key
MAIL_FROM=accounts@your-verified-domain.com
AUTH_SECRET=replace-with-a-random-secret-of-at-least-32-characters

# MinIO S3 API behind Caddy on the Droplet.
STORAGE_ENDPOINT=https://storage.example.com
# Optional: use this only when the app talks to MinIO over a private Docker
# hostname but browser presigned URLs must use public HTTPS.
STORAGE_PUBLIC_ENDPOINT=https://storage.example.com
STORAGE_REGION=us-east-1
STORAGE_BUCKET=tender-demo
STORAGE_ACCESS_KEY_ID=replace-with-the-MinIO-application-access-key
STORAGE_SECRET_ACCESS_KEY=replace-with-the-MinIO-application-secret-key
STORAGE_FORCE_PATH_STYLE=true

# Independent random values, each at least 32 characters. These authenticate
# Independent random values used by the worker routes.
SELECTION_WORKER_SECRET=replace-with-a-random-secret-of-at-least-32-characters
AGREEMENT_WORKER_SECRET=replace-with-a-random-secret-of-at-least-32-characters

# Supply these only while running `pnpm seed:demo`; do not keep them in Vercel.
DEMO_SEED_CONFIRM=tender_demo
DEMO_SEED_PASSWORD=replace-with-a-random-demo-password-of-at-least-12-characters
