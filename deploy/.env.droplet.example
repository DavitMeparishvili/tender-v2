# Copy to deploy/.env.droplet on the Droplet and replace every value.
# Keep the real file private: `chmod 600 deploy/.env.droplet`.
#
# The image is published by GitHub Actions.
APP_IMAGE=ghcr.io/DavitMeparishvili/tender-v2:latest

POSTGRES_DB=tender_demo
POSTGRES_USER=tender_app
POSTGRES_PASSWORD=replace-with-a-url-safe-random-password

MINIO_ROOT_USER=tender_minio_admin
MINIO_ROOT_PASSWORD=replace-with-a-long-random-root-password
MINIO_APP_ACCESS_KEY=tender_app
MINIO_APP_SECRET_KEY=replace-with-a-long-random-application-secret
MINIO_BUCKET=tender-demo

# Domains without https:// or a trailing slash.
APP_DOMAIN=tender-market.online
STORAGE_DOMAIN=s3.tender-market.online
APP_ORIGIN=https://tender-market.online
STORAGE_PUBLIC_ENDPOINT=https://s3.tender-market.online

AUTH_SECRET=replace-with-a-random-secret-of-at-least-32-characters
SELECTION_WORKER_SECRET=replace-with-a-random-secret-of-at-least-32-characters
AGREEMENT_WORKER_SECRET=replace-with-a-random-secret-of-at-least-32-characters
