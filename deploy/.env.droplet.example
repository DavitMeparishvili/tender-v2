# Copy to deploy/.env.droplet on the Droplet and set mode 600.
# Compose reads this file; it must never be committed.
POSTGRES_DB=tender_demo
POSTGRES_USER=tender_app
POSTGRES_PASSWORD=replace-with-a-long-random-database-password

MINIO_ROOT_USER=tender_minio_admin
MINIO_ROOT_PASSWORD=replace-with-a-long-random-root-password
MINIO_APP_ACCESS_KEY=tender_app
MINIO_APP_SECRET_KEY=replace-with-a-long-random-application-secret
MINIO_BUCKET=tender-demo

# Public application and storage origins, without trailing slashes.
APP_ORIGIN=https://demo.example.com
STORAGE_DOMAIN=storage.example.com
