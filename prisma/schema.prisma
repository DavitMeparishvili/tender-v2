generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum CapabilityCode {
  CUSTOMER
  PROVIDER
  ADMIN
}

enum ProviderSpecialtyCode {
  CONSTRUCTION_REPAIR
  TRANSPORT
  EQUIPMENT
  DAILY_LABOR
  MATERIAL_SUPPLIER
}

enum TenderServiceCode {
  GENERAL_CONSTRUCTION
  RENOVATION_REMODELING
  ARCHITECTURE_DESIGN
  DEMOLITION_DISMANTLING
  EARTHWORKS_EXCAVATION
  FOUNDATION_WORK
  CONCRETE_REINFORCED_CONCRETE
  MASONRY_BLOCK_BRICK
  ROOFING
  FACADE_INSULATION
  WATERPROOFING
  CARPENTRY_JOINERY
  METALWORK_WELDING
  ELECTRICAL_INSTALLATION
  PLUMBING
  HEATING_COOLING_VENTILATION
  DRYWALL_PLASTERING
  PAINTING_DECORATING
  TILING_STONEWORK
  FLOORING
  WINDOWS_DOORS
  LOW_VOLTAGE_SECURITY
  LANDSCAPING_EXTERNAL_WORKS
  OTHER_CONSTRUCTION_REPAIR
  CONSTRUCTION_MATERIAL_DELIVERY
  GENERAL_CARGO_TRANSPORT
  WASTE_DEBRIS_REMOVAL
  SOIL_INERT_MATERIAL_TRANSPORT
  FURNITURE_APPLIANCE_MOVING
  HEAVY_OVERSIZED_HAULAGE
  SPECIAL_PURPOSE_TRANSPORT
  OTHER_TRANSPORT
  EXCAVATOR
  MINI_EXCAVATOR
  BULLDOZER
  MOBILE_CRANE
  CONCRETE_PUMP
  DUMP_TRUCK
  WHEEL_LOADER
  FORKLIFT
  GRADER
  ROAD_ROLLER_COMPACTOR
  MANIPULATOR_CRANE_TRUCK
  AERIAL_WORK_PLATFORM
  DRILLING_RIG
  GENERATOR_COMPRESSOR
  SCAFFOLDING_FORMWORK
  OTHER_CONSTRUCTION_EQUIPMENT
  GENERAL_DAY_LABOR
  LOADERS_MATERIAL_HANDLERS
  DEMOLITION_CREW
  EARTHWORK_CREW
  CONCRETE_CREW_HELPERS
  SITE_CLEANUP
  WAREHOUSE_LABOR
  OTHER_LABOR
  CEMENT_DRY_MIXES
  REINFORCEMENT_STEEL
  READY_MIX_CONCRETE
  BLOCKS_BRICKS
  METAL_PROFILES
  TIMBER_WOOD
  DRYWALL_PLASTER_MATERIALS
  PAINT_COATINGS
  PLUMBING_MATERIALS
  ELECTRICAL_MATERIALS
  ROOFING_MATERIALS
  FINISHING_TILES_STONE
  INSULATION_MATERIALS
  SAND_GRAVEL_INERT
  WINDOWS_DOORS_MATERIALS
  OTHER_CONSTRUCTION_MATERIALS
}

model User {
  id              String           @id
  name            String
  email           String
  emailVerified   Boolean          @default(false)
  image           String?
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt
  sessions        Session[]
  accounts        Account[]
  capabilities    UserCapability[]
  profile         UserProfile?
  providerProfile ProviderProfile?
  tenders         Tender[]
  entitlements    AccessEntitlement[]
  bids            Bid[]
  agreementsAsClient   Agreement[]         @relation("AgreementClient")
  agreementsAsProvider Agreement[]         @relation("AgreementProvider")
  inboxNotifications   InboxNotification[]
  reviewsWritten       Review[]            @relation("ReviewAuthor")
  reviewsReceived      Review[]            @relation("ReviewSubject")

  @@unique([email])
  @@map("user")
}

model Session {
  id        String   @id
  expiresAt DateTime
  token     String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  ipAddress String?
  userAgent String?
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([token])
  @@index([userId])
  @@map("session")
}

model Account {
  id                    String    @id
  accountId             String
  providerId            String
  userId                String
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  password              String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  @@index([userId])
  @@map("account")
}

model Verification {
  id         String   @id
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([identifier])
  @@map("verification")
}

model UserCapability {
  id        String         @id
  userId    String
  code      CapabilityCode
  grantedAt DateTime       @default(now())
  grantedBy String?
  user      User           @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, code])
  @@index([code, userId])
}

model UserProfile {
  id                    String    @id
  userId                String    @unique
  accountKind           String
  displayName           String
  phoneE164             String    @unique
  phoneVerifiedAt       DateTime?
  countryCode           String    @default("GE")
  city                  String
  activityDescription   String
  preferredLocale       String    @default("ka")
  preferredCurrency     String    @default("GEL")
  profilePhotoObjectKey String?
  onboardingCompleteAt  DateTime?
  disabledAt            DateTime?
  restrictedUntil       DateTime?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model ProviderProfile {
  id          String                  @id
  userId      String                  @unique
  specialties ProviderSpecialtyCode[]
  user        User                    @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt   DateTime                @default(now())
  updatedAt   DateTime                @updatedAt
}

model AuditEvent {
  id            String   @id
  actorId       String?
  action        String
  targetType    String
  targetId      String
  reason        String?
  correlationId String
  metadata      Json
  createdAt     DateTime @default(now())

  @@index([targetType, targetId, createdAt])
  @@index([actorId, createdAt])
}

enum TenderStatus {
  DRAFT
  PUBLISHED
  // Selection ran and produced a winner.
  CLOSED
  // The deadline passed with no eligible bid.
  EXPIRED
  CANCELLED
}

enum EntitlementKind {
  SINGLE_TENDER
  MONTHLY_PROVIDER
  ANNUAL_PROVIDER
  ADMIN_OVERRIDE
}

enum PaymentEventStatus {
  PENDING
  SUCCEEDED
  FAILED
  CANCELLED
}

enum BidStatus {
  SUBMITTED
  WINNER
  LOST
  WITHDRAWN
}

enum SelectionOutcome {
  WINNER_SELECTED
  EXPIRED_NO_BIDS
}

enum AgreementStatus {
  PENDING_CONFIRMATION
  AGREED
  IN_PROGRESS
  COMPLETED
  CANCELLED
}

enum AgreementCancellationReasonCode {
  PARTY_DECLINED
  SCHEDULE_CHANGED
  SCOPE_CANNOT_PROCEED
  OTHER
  CONFIRMATION_EXPIRED
}

enum ReviewStatus {
  PUBLISHED
  REDACTED
}

// How the client located the job. It is persisted because it is not derivable
// from the stored location: an ADDRESS tender keeps the street address the
// client typed, a PIN tender keeps the pin they placed, and resuming a draft
// in the wrong mode makes the wizard re-submit the other kind of command and
// destroy whichever of the two the client actually provided.
enum TenderLocationMode {
  ADDRESS
  PIN
}

enum GeorgianPlaceKind {
  CAPITAL
  REGIONAL_CENTER
  MUNICIPAL_CENTER
  SETTLEMENT
}

model GeorgianPlace {
  // Stable GeoNames identifier. Keeping the upstream id makes future catalog
  // refreshes deterministic instead of matching mutable display names.
  id           Int               @id
  nameEn       String
  nameKa       String
  kind         GeorgianPlaceKind
  featureCode  String
  latitude     Float
  longitude    Float
  population   Int               @default(0)
  admin1Code   String?
  isActive     Boolean           @default(true)
  tenders      Tender[]

  @@index([isActive, kind, population(sort: Desc), nameEn])
}

model Tender {
  id               String        @id
  ownerId          String
  owner            User          @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  status           TenderStatus  @default(DRAFT)
  specialty        ProviderSpecialtyCode
  serviceCode      TenderServiceCode
  title            String
  shortDescription String?
  fullDescription  String?
  scopeOfWork      String?
  budgetMinorUnits Int?
  currency         String?
  desiredStartDate DateTime?
  deadline         DateTime?
  workerNotes      String?
  equipmentNotes   String?
  materialNotes    String?
  countryCode      String?
  locationMode     TenderLocationMode?
  georgianPlaceId  Int?
  georgianPlace    GeorgianPlace? @relation(fields: [georgianPlaceId], references: [id], onDelete: SetNull)
  city             String?
  district         String?
  addressLine      String?
  exactLatitude    Float?
  exactLongitude   Float?
  publicLatitude   Float?
  publicLongitude  Float?
  conditions       String?
  publishedAt      DateTime?
  cancelledAt      DateTime?
  cancelReason     String?
  createdAt        DateTime      @default(now())
  updatedAt        DateTime      @updatedAt
  attachments      TenderAttachment[]
  bids             Bid[]

  @@index([ownerId, status])
  @@index([georgianPlaceId])
  @@index([status, specialty, serviceCode, city, deadline])
}

model TenderAttachment {
  id               String   @id
  tenderId         String
  tender           Tender   @relation(fields: [tenderId], references: [id], onDelete: Cascade)
  objectKey        String   @unique
  originalFileName String
  mimeType         String
  sizeBytes        Int
  createdAt        DateTime @default(now())

  @@index([tenderId])
}

model OutboxMessage {
  id          String    @id
  topic       String
  aggregateId String
  payload     Json
  availableAt DateTime
  processedAt DateTime?
  attempts    Int       @default(0)
  createdAt   DateTime  @default(now())

  @@index([processedAt, availableAt])
}

model AccessEntitlement {
  id            String          @id
  providerId    String
  provider      User            @relation(fields: [providerId], references: [id], onDelete: Cascade)
  kind          EntitlementKind
  // Null for subscriptions. No relation is declared to Tender: an entitlement
  // is a purchase record and must survive the tender it was bought for.
  tenderId      String?
  grantedAt     DateTime
  expiresAt     DateTime?
  sourceEventId String?         @unique
  createdAt     DateTime        @default(now())

  @@index([providerId, kind, expiresAt])
  @@index([providerId, tenderId])
}

model PaymentEvent {
  // The idempotency key. A real Phase 5 webhook carries the provider's event
  // id here; the mock adapter derives a deterministic one from the checkout.
  externalEventId  String             @id
  checkoutId       String             @unique
  providerId       String
  product          String
  tenderId         String?
  amountMinorUnits Int
  currency         String
  status           PaymentEventStatus @default(PENDING)
  rawPayload       Json
  receivedAt       DateTime           @default(now())
  appliedAt        DateTime?

  @@index([providerId, receivedAt])
}

model Bid {
  id                   String    @id
  tenderId             String
  tender               Tender    @relation(fields: [tenderId], references: [id], onDelete: Cascade)
  providerId           String
  provider             User      @relation(fields: [providerId], references: [id], onDelete: Cascade)
  amountMinorUnits     Int
  currency             String
  status               BidStatus @default(SUBMITTED)
  proposedStartDate    DateTime?
  durationDays         Int?
  includedCosts        String?
  exclusions           String?
  conditions           String
  // Reset on every revision, so a revised bid loses its original queue
  // position for tie-breaking (program design §4.3).
  qualifyingSubmittedAt DateTime
  withdrawnAt          DateTime?
  createdAt            DateTime  @default(now())
  updatedAt            DateTime  @updatedAt

  // One active bid per provider per tender. A withdrawal keeps the row, so
  // this also prevents a withdrawn bidder from opening a second record.
  @@unique([tenderId, providerId])
  // Serves the ranking read directly: amount, then queue position, then id.
  @@index([tenderId, status, amountMinorUnits, qualifyingSubmittedAt, id])
}

model TenderSelection {
  id           String           @id
  // The hard idempotency guarantee: a second selection for the same tender
  // cannot insert, no matter how many workers race.
  tenderId     String           @unique
  outcome      SelectionOutcome
  winningBidId String?          @unique
  agreementId  String?          @unique
  ranAt        DateTime
  createdAt    DateTime         @default(now())
}

model Agreement {
  id               String                           @id
  tenderId         String                           @unique
  clientId         String
  client           User                             @relation("AgreementClient", fields: [clientId], references: [id], onDelete: Restrict)
  providerId       String
  provider         User                             @relation("AgreementProvider", fields: [providerId], references: [id], onDelete: Restrict)
  bidId            String                           @unique
  status           AgreementStatus                  @default(PENDING_CONFIRMATION)
  amountMinorUnits Int
  currency         String
  tenderTitle      String
  // The immutable snapshot of the winning offer's terms. Phase 4 reads it to
  // present the same text both parties confirm.
  snapshot         Json
  confirmDeadline  DateTime
  clientConfirmedAt       DateTime?
  providerConfirmedAt     DateTime?
  clientStartedAt         DateTime?
  providerStartedAt       DateTime?
  clientCompletedAt       DateTime?
  providerCompletedAt     DateTime?
  cancelledAt             DateTime?
  cancelledById           String?
  cancellationReasonCode  AgreementCancellationReasonCode?
  cancellationExplanation String?
  completedAt             DateTime?
  createdAt        DateTime                         @default(now())
  updatedAt        DateTime                         @default(now()) @updatedAt
  reviews          Review[]

  @@index([clientId, status, updatedAt])
  @@index([providerId, status, updatedAt])
  @@index([status, confirmDeadline])
}

model InboxNotification {
  id            String   @id
  recipientId   String
  recipient     User     @relation(fields: [recipientId], references: [id], onDelete: Cascade)
  topic         String
  aggregateType String
  aggregateId   String
  messageKey    String
  variables     Json
  readAt        DateTime?
  createdAt     DateTime @default(now())

  @@index([recipientId, createdAt(sort: Desc)])
  @@index([recipientId, readAt, createdAt(sort: Desc)])
}

model Review {
  id              String       @id
  agreementId     String
  agreement       Agreement    @relation(fields: [agreementId], references: [id], onDelete: Restrict)
  reviewerId      String
  reviewer        User         @relation("ReviewAuthor", fields: [reviewerId], references: [id], onDelete: Restrict)
  reviewedId      String
  reviewed        User         @relation("ReviewSubject", fields: [reviewedId], references: [id], onDelete: Restrict)
  quality         Int
  deadline        Int
  communication   Int
  agreedPrice     Int
  comment         String
  status          ReviewStatus @default(PUBLISHED)
  redactedAt      DateTime?
  redactedById    String?
  redactionReason String?
  createdAt       DateTime     @default(now())

  @@unique([agreementId, reviewerId])
  @@index([reviewedId, status, createdAt(sort: Desc)])
  @@index([status, createdAt(sort: Desc)])
}
