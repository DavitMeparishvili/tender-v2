generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum CapabilityCode {
  CUSTOMER
  PROVIDER
  ADMIN
}

enum ProviderSpecialtyCode {
  CONSTRUCTION_REPAIR
  TRANSPORT
  EQUIPMENT
  DAILY_LABOR
  MATERIAL_SUPPLIER
}

model User {
  id              String           @id
  name            String
  email           String
  emailVerified   Boolean          @default(false)
  image           String?
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt
  sessions        Session[]
  accounts        Account[]
  capabilities    UserCapability[]
  profile         UserProfile?
  providerProfile ProviderProfile?
  tenders         Tender[]

  @@unique([email])
  @@map("user")
}

model Session {
  id        String   @id
  expiresAt DateTime
  token     String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  ipAddress String?
  userAgent String?
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([token])
  @@index([userId])
  @@map("session")
}

model Account {
  id                    String    @id
  accountId             String
  providerId            String
  userId                String
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  password              String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  @@index([userId])
  @@map("account")
}

model Verification {
  id         String   @id
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([identifier])
  @@map("verification")
}

model UserCapability {
  id        String         @id
  userId    String
  code      CapabilityCode
  grantedAt DateTime       @default(now())
  grantedBy String?
  user      User           @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, code])
  @@index([code, userId])
}

model UserProfile {
  id                    String    @id
  userId                String    @unique
  accountKind           String
  displayName           String
  phoneE164             String    @unique
  phoneVerifiedAt       DateTime?
  countryCode           String    @default("GE")
  city                  String
  activityDescription   String
  preferredLocale       String    @default("ka")
  preferredCurrency     String    @default("GEL")
  profilePhotoObjectKey String?
  onboardingCompleteAt  DateTime?
  disabledAt            DateTime?
  restrictedUntil       DateTime?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model ProviderProfile {
  id          String                  @id
  userId      String                  @unique
  specialties ProviderSpecialtyCode[]
  user        User                    @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt   DateTime                @default(now())
  updatedAt   DateTime                @updatedAt
}

model AuditEvent {
  id            String   @id
  actorId       String?
  action        String
  targetType    String
  targetId      String
  reason        String?
  correlationId String
  metadata      Json
  createdAt     DateTime @default(now())

  @@index([targetType, targetId, createdAt])
  @@index([actorId, createdAt])
}

enum TenderStatus {
  DRAFT
  PUBLISHED
  CANCELLED
}

// How the client located the job. It is persisted because it is not derivable
// from the stored location: an ADDRESS tender keeps the street address the
// client typed, a PIN tender keeps the pin they placed, and resuming a draft
// in the wrong mode makes the wizard re-submit the other kind of command and
// destroy whichever of the two the client actually provided.
enum TenderLocationMode {
  ADDRESS
  PIN
}

model Tender {
  id               String        @id
  ownerId          String
  owner            User          @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  status           TenderStatus  @default(DRAFT)
  specialty        ProviderSpecialtyCode
  title            String
  shortDescription String?
  fullDescription  String?
  scopeOfWork      String?
  budgetMinorUnits Int?
  currency         String?
  desiredStartDate DateTime?
  deadline         DateTime?
  workerNotes      String?
  equipmentNotes   String?
  materialNotes    String?
  countryCode      String?
  locationMode     TenderLocationMode?
  city             String?
  district         String?
  addressLine      String?
  exactLatitude    Float?
  exactLongitude   Float?
  publicLatitude   Float?
  publicLongitude  Float?
  conditions       String?
  publishedAt      DateTime?
  cancelledAt      DateTime?
  cancelReason     String?
  createdAt        DateTime      @default(now())
  updatedAt        DateTime      @updatedAt
  attachments      TenderAttachment[]

  @@index([ownerId, status])
  @@index([status, specialty, city, deadline])
}

model TenderAttachment {
  id               String   @id
  tenderId         String
  tender           Tender   @relation(fields: [tenderId], references: [id], onDelete: Cascade)
  objectKey        String   @unique
  originalFileName String
  mimeType         String
  sizeBytes        Int
  createdAt        DateTime @default(now())

  @@index([tenderId])
}

model OutboxMessage {
  id          String    @id
  topic       String
  aggregateId String
  payload     Json
  availableAt DateTime
  processedAt DateTime?
  attempts    Int       @default(0)
  createdAt   DateTime  @default(now())

  @@index([processedAt, availableAt])
}
